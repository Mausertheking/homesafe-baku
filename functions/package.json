{
  "name": "homesafe-functions",
  "private": true,
  "description": "HomeSafe Cloud Functions (2nd gen, TypeScript)",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync": "../tool/sync_shared.sh",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed": "node lib/scripts/seed.js",
    "deploy": "npm run build && firebase deploy --only functions",
    "test:emulator": "cd .. && firebase emulators:exec --project demo-homesafe --only firestore \"npm --prefix functions test\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "archiver": "^8.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
